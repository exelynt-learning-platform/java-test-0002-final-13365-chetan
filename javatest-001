public class Pattern {

    static final int ROWS = 5;

    public static void main(String[] args) {

        for (int i = 1; i <= ROWS; i++) {

            for (int j = i; j < ROWS; j++) {
                System.out.print("  ");
            }

            for (int j = 1; j <= i; j++) {
                System.out.print(j + " ");
            }

            for (int j = i - 1; j >= 1; j--) {
                System.out.print(j + " ");
            }

            System.out.println();
        }
    }
}